{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "PYTHONPATH=. pytest tests/ scripts/",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "icons:generate": "python scripts/generate_icons.py",
    "android:init": "pnpm install @capacitor/core @capacitor/cli @capacitor/android && npx cap init",
    "android:add": "npx cap add android",
    "android:sync": "pnpm docs:build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "android:run": "pnpm android:sync && npx cap run android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juninmd/meu-livro.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/juninmd/meu-livro/issues"
  },
  "homepage": "https://github.com/juninmd/meu-livro#readme",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^25.5.0",
    "semantic-release": "^23.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "medium-zoom": "^1.1.0"
  },
  "optionalDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1"
  },
  "packageManager": "pnpm@10.30.3",
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "docs-build.zip",
              "label": "Documentation Build"
            }
          ]
        }
      ]
    ]
  }
}